<c:RetroWindow x:Class="Itorrent.Desktop.Views.AddTorrentDialog"
               xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
               xmlns:l="clr-namespace:Itorrent.Desktop.Localization"
               xmlns:c="clr-namespace:Itorrent.Desktop.Controls"
               xmlns:a="clr-namespace:Itorrent.Desktop.Assets"
               xmlns:vm="clr-namespace:Itorrent.Desktop.ViewModels"
               Title="{Binding DialogTitle}" IsDialog="True"
               Width="640" Height="590" MinWidth="520" MinHeight="460"
               WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Grid Margin="12,10,12,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Cabeçalho: nome e tamanho -->
        <DockPanel>
            <Image DockPanel.Dock="Left" Source="/Itorrent;component/Assets/itorrent-48.png" Width="48" Height="48" VerticalAlignment="Top"
                   Margin="0,0,12,0" RenderOptions.BitmapScalingMode="HighQuality" />
            <StackPanel>
                <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="14" TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding Title}" />
                <StackPanel Orientation="Horizontal" Margin="0,4,0,0" Visibility="{Binding IsReady, Converter={StaticResource BoolToVis}}">
                    <TextBlock Style="{StaticResource Label}" Text="{l:L Add.TotalSize}" />
                    <TextBlock Text="{Binding TotalSizeText}" Margin="0,0,16,0" />
                    <TextBlock Style="{StaticResource Label}" Text="{l:L Add.Files}" />
                    <TextBlock Text="{Binding FileCountText}" Margin="0,0,16,0" />
                    <TextBlock Style="{StaticResource Label}" Text="{l:L Add.Private}" />
                    <TextBlock Text="{Binding PrivateText}" />
                </StackPanel>
                <TextBlock Text="{Binding Comment}" Foreground="{StaticResource Shadow}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"
                           Visibility="{Binding Comment, Converter={StaticResource ShowIf}}" />
            </StackPanel>
        </DockPanel>

        <StackPanel Grid.Row="1">
            <!-- Alerta de executáveis -->
            <Border Margin="0,10,0,0" Background="#FFFFE1" BorderBrush="{StaticResource Alert}" BorderThickness="2" Padding="6"
                    Visibility="{Binding HasRiskyFiles, Converter={StaticResource BoolToVis}}">
                <DockPanel>
                    <Image DockPanel.Dock="Left" Source="{a:Pixel Warning}" Width="32" Height="32" VerticalAlignment="Top" Margin="0,0,8,0" />
                    <StackPanel>
                        <TextBlock Text="{l:L Add.RiskTitle}" FontWeight="Bold" Foreground="{StaticResource Alert}" />
                        <TextBlock Text="{Binding RiskText}" TextWrapping="Wrap" Margin="0,2,0,0" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Modo "baixar novamente" -->
            <Border Margin="0,10,0,0" Background="White" BorderBrush="Black" BorderThickness="1" Padding="6"
                    Visibility="{Binding IsEditing, Converter={StaticResource BoolToVis}}">
                <DockPanel>
                    <Image DockPanel.Dock="Left" Source="{a:Pixel Down}" Width="32" Height="32" VerticalAlignment="Top" Margin="0,0,8,0" />
                    <TextBlock Text="{Binding EditingHint}" TextWrapping="Wrap" VerticalAlignment="Center" />
                </DockPanel>
            </Border>
        </StackPanel>

        <!-- Ações de seleção -->
        <DockPanel Grid.Row="2" Margin="0,10,0,4">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="{l:L Add.SelectAll}" Command="{Binding SelectAllCommand}" Margin="0,0,6,0" Padding="8,2" />
                <Button Content="{l:L Add.SelectNone}" Command="{Binding SelectNoneCommand}" Padding="8,2" />
            </StackPanel>
            <TextBlock Style="{StaticResource Label}" Text="{l:L Add.ToDownload}" />
        </DockPanel>

        <!-- Árvore de arquivos (ou "procurando...") -->
        <Border Grid.Row="3" BorderBrush="Black" BorderThickness="1" Background="White">
            <Grid>
                <TreeView ItemsSource="{Binding Roots}" Padding="2"
                          Visibility="{Binding IsReady, Converter={StaticResource BoolToVis}}">
                    <TreeView.ItemTemplate>
                        <HierarchicalDataTemplate DataType="vm:FileNode" ItemsSource="{Binding Children}">
                            <DockPanel Margin="0,1" LastChildFill="True">
                                <TextBlock DockPanel.Dock="Right" Text="{Binding SizeText}" Foreground="{StaticResource Shadow}"
                                           Margin="16,0,4,0" VerticalAlignment="Center" />
                                <CheckBox IsChecked="{Binding IsChecked}" Margin="0,0,4,0" VerticalAlignment="Center" Focusable="False" />
                                <Image Source="{Binding Icon}" Width="16" Height="16" Margin="0,0,4,0" />
                                <TextBlock Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsRisky}" Value="True">
                                                    <Setter Property="Foreground" Value="{StaticResource Alert}" />
                                                    <Setter Property="FontWeight" Value="Bold" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DockPanel>
                        </HierarchicalDataTemplate>
                    </TreeView.ItemTemplate>
                </TreeView>

                <StackPanel VerticalAlignment="Center" Margin="40,0" Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}">
                    <Image Source="{a:Pixel Hourglass}" Width="32" Height="32" />
                    <TextBlock Text="{l:L Add.Fetching}" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,8" />
                    <ContentControl Style="{StaticResource BusyBar}" Width="360" />
                    <TextBlock Text="{l:L Add.FetchingHint}" Foreground="{StaticResource Shadow}"
                               HorizontalAlignment="Center" Margin="0,8,0,0" />
                </StackPanel>
            </Grid>
        </Border>

        <TextBlock Grid.Row="4" Text="{Binding SelectionText}" Margin="0,4,0,0" FontWeight="Bold" />

        <!-- Pasta de destino -->
        <GroupBox Grid.Row="5" Header="{l:L Add.SaveTo}" Margin="0,10,0,0" Background="{StaticResource Face}">
            <StackPanel>
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="{l:L Add.Browse}" Command="{Binding BrowseCommand}" Margin="6,0,0,0" />
                    <Image DockPanel.Dock="Left" Source="{a:Pixel Folder}" Width="16" Height="16" Margin="0,0,6,0" />
                    <TextBox Text="{Binding SavePath, UpdateSourceTrigger=PropertyChanged}" VerticalContentAlignment="Center"
                             IsReadOnly="{Binding IsEditing}" />
                </DockPanel>
                <DockPanel Margin="22,4,0,0">
                    <TextBlock DockPanel.Dock="Right" Text="{Binding FreeSpaceText}" Foreground="{StaticResource Shadow}" />
                    <CheckBox Content="{l:L Add.MakeDefault}" IsChecked="{Binding RememberFolder}"
                              Visibility="{Binding IsNew, Converter={StaticResource BoolToVis}}" />
                </DockPanel>
            </StackPanel>
        </GroupBox>

        <!-- Erro -->
        <TextBlock Grid.Row="6" Text="{Binding Error}" Foreground="{StaticResource Alert}" FontWeight="Bold" TextWrapping="Wrap"
                   Margin="0,6,0,0" Visibility="{Binding Error, Converter={StaticResource ShowIf}}" />

        <!-- Botões -->
        <StackPanel Grid.Row="7" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="{l:L Add.Download}" IsDefault="True" Command="{Binding ConfirmCommand}" Width="96" Margin="0,0,8,0" />
            <Button Content="{l:L Common.Cancel}" IsCancel="True" Width="96" />
        </StackPanel>
    </Grid>
</c:RetroWindow>
