<c:RetroWindow x:Class="Itorrent.Desktop.Views.SmallDialog"
               xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
               xmlns:c="clr-namespace:Itorrent.Desktop.Controls"
               IsDialog="True" ResizeMode="NoResize" SizeToContent="WidthAndHeight"
               WindowStartupLocation="CenterOwner" ShowInTaskbar="False" MaxWidth="560">
    <Grid Margin="14,12,14,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Image x:Name="DialogIcon" Width="32" Height="32" VerticalAlignment="Top" Margin="0,0,14,0" />
        <StackPanel Grid.Column="1" x:Name="Body" MinWidth="300" />

        <StackPanel Grid.Row="1" Grid.ColumnSpan="2" x:Name="Buttons" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,16,0,0" />
    </Grid>
</c:RetroWindow>
