<c:RetroWindow x:Class="Itorrent.Desktop.Views.MainWindow"
               xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
               xmlns:c="clr-namespace:Itorrent.Desktop.Controls"
               xmlns:a="clr-namespace:Itorrent.Desktop.Assets"
               xmlns:vm="clr-namespace:Itorrent.Desktop.ViewModels"
               Title="Itorrent - Gerenciador de Transferências"
               Width="1060" Height="700" MinWidth="720" MinHeight="460"
               WindowStartupLocation="CenterScreen" AllowDrop="True">
    <c:RetroWindow.Resources>
        <!-- Ícone de grupo minimizado (Gerenciador de Programas) usado como filtro -->
        <Style x:Key="GroupIcon" TargetType="RadioButton">
            <Setter Property="Margin" Value="6,4,14,2" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <StackPanel Width="78" Background="Transparent">
                            <Image Source="{a:Pixel Group}" Width="32" Height="32" />
                            <Border x:Name="Label" HorizontalAlignment="Center" Padding="2,0" Margin="0,2,0,0">
                                <ContentPresenter x:Name="Text" TextBlock.FontSize="11" HorizontalAlignment="Center" />
                            </Border>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Label" Property="Background" Value="{StaticResource Navy}" />
                                <Setter TargetName="Text" Property="TextBlock.Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="InfoKey" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Margin" Value="0,2,8,2" />
        </Style>
        <Style x:Key="InfoValue" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,2" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <ContextMenu x:Key="TorrentMenu">
            <MenuItem Header="_Pausar" Command="{Binding PauseCommand}" />
            <MenuItem Header="_Retomar" Command="{Binding ResumeCommand}" />
            <Separator />
            <MenuItem Header="Abrir _pasta" Command="{Binding OpenFolderCommand}" />
            <Separator />
            <MenuItem Header="Re_mover..." Command="{Binding RemoveCommand}" />
        </ContextMenu>
    </c:RetroWindow.Resources>

    <c:RetroWindow.InputBindings>
        <KeyBinding Key="O" Modifiers="Control" Command="{Binding AddFileCommand}" />
        <KeyBinding Key="M" Modifiers="Control" Command="{Binding AddMagnetCommand}" />
        <KeyBinding Key="V" Modifiers="Control" Command="{Binding AddMagnetCommand}" />
        <KeyBinding Key="Delete" Command="{Binding RemoveCommand}" />
    </c:RetroWindow.InputBindings>

    <DockPanel>
        <!-- ===== Menu ===== -->
        <Border DockPanel.Dock="Top" BorderBrush="Black" BorderThickness="0,0,0,1">
            <Menu>
                <MenuItem Header="_Arquivo">
                    <MenuItem Header="Abrir arquivo ._torrent..." InputGestureText="Ctrl+O" Command="{Binding AddFileCommand}" />
                    <MenuItem Header="Adicionar link _magnet..." InputGestureText="Ctrl+M" Command="{Binding AddMagnetCommand}" />
                    <Separator />
                    <MenuItem Header="_Ocultar na bandeja" Click="HideToTray_Click" />
                    <MenuItem Header="_Sair" Click="Exit_Click" />
                </MenuItem>
                <MenuItem Header="_Transferências">
                    <MenuItem Header="_Pausar" Command="{Binding PauseCommand}" />
                    <MenuItem Header="_Retomar" Command="{Binding ResumeCommand}" />
                    <MenuItem Header="Re_mover..." InputGestureText="Del" Command="{Binding RemoveCommand}" />
                    <MenuItem Header="Abrir _pasta" Command="{Binding OpenFolderCommand}" />
                    <Separator />
                    <MenuItem Header="Pausar _tudo" Command="{Binding PauseAllCommand}" />
                    <MenuItem Header="Retomar t_udo" Command="{Binding ResumeAllCommand}" />
                </MenuItem>
                <MenuItem Header="_Opções">
                    <MenuItem Header="Modo _Turbo" IsCheckable="True" IsChecked="{Binding IsTurbo}" />
                    <Separator />
                    <MenuItem Header="_Configurações..." Command="{Binding SettingsCommand}" />
                </MenuItem>
                <MenuItem Header="_Janela">
                    <MenuItem Header="1 _Todos" Command="{Binding FilterCommand}" CommandParameter="{x:Static vm:TorrentFilter.All}" />
                    <MenuItem Header="2 _Baixando" Command="{Binding FilterCommand}" CommandParameter="{x:Static vm:TorrentFilter.Downloading}" />
                    <MenuItem Header="3 _Concluídos" Command="{Binding FilterCommand}" CommandParameter="{x:Static vm:TorrentFilter.Completed}" />
                    <MenuItem Header="4 _Pausados" Command="{Binding FilterCommand}" CommandParameter="{x:Static vm:TorrentFilter.Paused}" />
                </MenuItem>
                <MenuItem Header="_?">
                    <MenuItem Header="_Sobre o Itorrent..." Command="{Binding AboutCommand}" />
                </MenuItem>
            </Menu>
        </Border>

        <!-- ===== Barra de ferramentas (estilo eMule) ===== -->
        <Border DockPanel.Dock="Top" Background="{StaticResource Face}" BorderBrush="Black" BorderThickness="0,0,0,1" Padding="5,4">
            <DockPanel>
                <ToggleButton DockPanel.Dock="Right" Style="{StaticResource ToolToggle}" MinWidth="96"
                              IsChecked="{Binding IsTurbo}"
                              ToolTip="Modo Turbo: liga UPnP, DHT, PEX, descoberta local, trackers públicos e até 500 conexões por torrent.">
                    <StackPanel>
                        <Image Source="{a:Pixel Turbo}" Width="32" Height="32" />
                        <TextBlock x:Name="TurboText" Text="{Binding TurboLabel}" HorizontalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsTurbo}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource Alert}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </ToggleButton>
                <StackPanel Orientation="Horizontal">
                    <Button Style="{StaticResource ToolButtonB}" Command="{Binding AddFileCommand}" ToolTip="Abrir arquivo .torrent (Ctrl+O)">
                        <StackPanel>
                            <Image Source="{a:Pixel TorrentFile}" Width="32" Height="32" />
                            <TextBlock Text="Abrir" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource ToolButtonB}" Command="{Binding AddMagnetCommand}" ToolTip="Adicionar link magnet (Ctrl+M)">
                        <StackPanel>
                            <Image Source="{a:Pixel Magnet}" Width="32" Height="32" />
                            <TextBlock Text="Magnet" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Rectangle Width="1" Fill="{StaticResource Shadow}" Margin="4,2,6,2" />
                    <Button Style="{StaticResource ToolButtonB}" Command="{Binding ResumeCommand}" ToolTip="Retomar">
                        <StackPanel>
                            <Image Source="{a:Pixel Play}" Width="32" Height="32" />
                            <TextBlock Text="Retomar" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource ToolButtonB}" Command="{Binding PauseCommand}" ToolTip="Pausar">
                        <StackPanel>
                            <Image Source="{a:Pixel Pause}" Width="32" Height="32" />
                            <TextBlock Text="Pausar" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource ToolButtonB}" Command="{Binding RemoveCommand}" ToolTip="Remover (Del)">
                        <StackPanel>
                            <Image Source="{a:Pixel Remove}" Width="32" Height="32" />
                            <TextBlock Text="Remover" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Rectangle Width="1" Fill="{StaticResource Shadow}" Margin="4,2,6,2" />
                    <Button Style="{StaticResource ToolButtonB}" Command="{Binding OpenFolderCommand}" ToolTip="Abrir a pasta do download">
                        <StackPanel>
                            <Image Source="{a:Pixel Folder}" Width="32" Height="32" />
                            <TextBlock Text="Pasta" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource ToolButtonB}" Command="{Binding SettingsCommand}" ToolTip="Configurações">
                        <StackPanel>
                            <Image Source="{a:Pixel Settings}" Width="32" Height="32" />
                            <TextBlock Text="Opções" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ===== Barra de status ===== -->
        <Border DockPanel.Dock="Bottom" Background="{StaticResource Face}" BorderBrush="Black" BorderThickness="0,1,0,0" Padding="4,3">
            <StackPanel Orientation="Horizontal" TextBlock.FontSize="11">
                <Border Style="{StaticResource StatusPanel}" Width="130">
                    <StackPanel Orientation="Horizontal" Margin="3,1">
                        <Image Source="{a:Pixel Down}" Width="16" Height="16" />
                        <TextBlock Text="{Binding DownText}" VerticalAlignment="Center" Margin="2,0" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource StatusPanel}" Width="130">
                    <StackPanel Orientation="Horizontal" Margin="3,1">
                        <Image Source="{a:Pixel Up}" Width="16" Height="16" />
                        <TextBlock Text="{Binding UpText}" VerticalAlignment="Center" Margin="2,0" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource StatusPanel}" Width="170">
                    <TextBlock Text="{Binding CountText}" Margin="4,2" VerticalAlignment="Center" />
                </Border>
                <Border Style="{StaticResource StatusPanel}" Width="96">
                    <TextBlock Text="{Binding PortText}" Margin="4,2" VerticalAlignment="Center" />
                </Border>
                <Border Style="{StaticResource StatusPanel}" Width="110">
                    <TextBlock Text="{Binding DhtText}" Margin="4,2" VerticalAlignment="Center" />
                </Border>
                <Border Style="{StaticResource StatusPanel}" Width="96">
                    <TextBlock Text="{Binding TurboStatusText}" Margin="4,2" VerticalAlignment="Center" FontWeight="Bold">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsTurbo}" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource Alert}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Border>
            </StackPanel>
        </Border>

        <!-- ===== Área de trabalho ===== -->
        <Grid Background="{StaticResource Workspace}">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" MinHeight="120" />
                <RowDefinition Height="6" />
                <RowDefinition Height="210" MinHeight="90" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Lista de transferências -->
            <c:ChildWindow x:Name="TransfersPanel" Header="{Binding FilterTitle}" Margin="8,8,8,0"
                           IsActive="{Binding IsKeyboardFocusWithin, RelativeSource={RelativeSource Self}}">
                <Grid>
                    <ListView x:Name="TorrentList" ItemsSource="{Binding TorrentsView}" SelectedItem="{Binding Selected}"
                              SelectionMode="Single" ContextMenu="{StaticResource TorrentMenu}">
                        <ListView.View>
                            <GridView AllowsColumnReorder="False">
                                <GridViewColumn Header="Nome" Width="300">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate DataType="vm:TorrentItemViewModel">
                                            <StackPanel Orientation="Horizontal">
                                                <Image Source="{Binding StatusIcon}" Width="16" Height="16" Margin="0,0,4,0" />
                                                <Image Source="{a:Pixel Warning}" Width="16" Height="16" Margin="0,0,4,0"
                                                       ToolTip="Contém arquivos executáveis"
                                                       Visibility="{Binding HasRiskyFiles, Converter={StaticResource BoolToVis}}" />
                                                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="Tamanho" Width="78" DisplayMemberBinding="{Binding SizeText}" />
                                <GridViewColumn Header="Progresso" Width="120">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate DataType="vm:TorrentItemViewModel">
                                            <ProgressBar Width="108" Maximum="100" Value="{Binding Progress, Mode=OneWay}" Tag="{Binding ProgressText}" />
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="Status" Width="116" DisplayMemberBinding="{Binding StatusText}" />
                                <GridViewColumn Header="Down" Width="80" DisplayMemberBinding="{Binding DownText}" />
                                <GridViewColumn Header="Up" Width="74" DisplayMemberBinding="{Binding UpText}" />
                                <GridViewColumn Header="Tempo" Width="66" DisplayMemberBinding="{Binding EtaText}" />
                                <GridViewColumn Header="Seeds" Width="74" DisplayMemberBinding="{Binding SeedsText}" />
                                <GridViewColumn Header="Peers" Width="74" DisplayMemberBinding="{Binding PeersText}" />
                                <GridViewColumn Header="Adicionado" Width="112" DisplayMemberBinding="{Binding AddedText}" />
                            </GridView>
                        </ListView.View>
                    </ListView>
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"
                                Visibility="{Binding Torrents.Count, Converter={StaticResource HideIf}, ConverterParameter=0}"
                                x:Name="EmptyHint">
                        <Image Source="{a:Pixel Magnet}" Width="48" Height="48" Opacity="0.7" />
                        <TextBlock Text="Nenhuma transferência." FontWeight="Bold" HorizontalAlignment="Center" Margin="0,6,0,2" />
                        <TextBlock Text="Clique em Magnet, abra um .torrent ou arraste-o para esta janela."
                                   Foreground="{StaticResource Shadow}" HorizontalAlignment="Center" />
                    </StackPanel>
                </Grid>
            </c:ChildWindow>

            <GridSplitter Grid.Row="1" HorizontalAlignment="Stretch" ResizeDirection="Rows" />

            <!-- Detalhes: arquivos + informações -->
            <Grid Grid.Row="2" Margin="8,0,8,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="6" />
                    <ColumnDefinition Width="300" />
                </Grid.ColumnDefinitions>

                <c:ChildWindow Header="{Binding DetailsTitle}"
                               IsActive="{Binding IsKeyboardFocusWithin, RelativeSource={RelativeSource Self}}">
                    <Grid>
                        <ListView ItemsSource="{Binding Files}">
                            <ListView.View>
                                <GridView AllowsColumnReorder="False">
                                    <GridViewColumn Header="Arquivo" Width="330">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate DataType="vm:FileItemViewModel">
                                                <StackPanel Orientation="Horizontal">
                                                    <Image Source="{Binding Icon}" Width="16" Height="16" Margin="0,0,4,0" />
                                                    <TextBlock Text="{Binding Path}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Header="Tamanho" Width="78" DisplayMemberBinding="{Binding SizeText}" />
                                    <GridViewColumn Header="Progresso" Width="112">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate DataType="vm:FileItemViewModel">
                                                <ProgressBar Width="100" Maximum="100" Value="{Binding Progress, Mode=OneWay}" Tag="{Binding ProgressText}" />
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Header="Alerta" Width="100" DisplayMemberBinding="{Binding RiskText}" />
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </Grid>
                </c:ChildWindow>

                <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" ResizeDirection="Columns" />

                <c:ChildWindow Grid.Column="2" Header="Informações"
                               IsActive="{Binding IsKeyboardFocusWithin, RelativeSource={RelativeSource Self}}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="8,6">
                        <Grid>
                            <TextBlock Text="Selecione uma transferência." Foreground="{StaticResource Shadow}"
                                       Visibility="{Binding Selected, Converter={StaticResource HideIf}}" />
                            <StackPanel DataContext="{Binding Selected}" Visibility="{Binding Converter={StaticResource ShowIf}}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                                        <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                                    </Grid.RowDefinitions>
                                    <TextBlock Style="{StaticResource InfoKey}" Text="Status:" />
                                    <TextBlock Style="{StaticResource InfoValue}" Grid.Column="1" Text="{Binding StatusText}" />
                                    <TextBlock Style="{StaticResource InfoKey}" Grid.Row="1" Text="Baixado:" />
                                    <TextBlock Style="{StaticResource InfoValue}" Grid.Row="1" Grid.Column="1" Text="{Binding DownloadedText}" />
                                    <TextBlock Style="{StaticResource InfoKey}" Grid.Row="2" Text="Progresso:" />
                                    <ProgressBar Grid.Row="2" Grid.Column="1" Maximum="100" Margin="0,2"
                                                 Value="{Binding Progress, Mode=OneWay}" Tag="{Binding ProgressText}" />
                                    <TextBlock Style="{StaticResource InfoKey}" Grid.Row="3" Text="Velocidade:" />
                                    <TextBlock Style="{StaticResource InfoValue}" Grid.Row="3" Grid.Column="1">
                                        <Run Text="↓" /><Run Text="{Binding DownText, Mode=OneWay}" />
                                        <Run Text="  ↑" /><Run Text="{Binding UpText, Mode=OneWay}" />
                                    </TextBlock>
                                    <TextBlock Style="{StaticResource InfoKey}" Grid.Row="4" Text="Tempo restante:" />
                                    <TextBlock Style="{StaticResource InfoValue}" Grid.Row="4" Grid.Column="1" Text="{Binding EtaText}" />
                                    <TextBlock Style="{StaticResource InfoKey}" Grid.Row="5" Text="Seeds:" />
                                    <TextBlock Style="{StaticResource InfoValue}" Grid.Row="5" Grid.Column="1"
                                               ToolTip="Conectados a você (total na rede, pelo tracker)">
                                        <Run Text="{Binding SeedsText, Mode=OneWay}" /><Run Text="   Peers: " FontWeight="Bold" /><Run Text="{Binding PeersText, Mode=OneWay}" />
                                    </TextBlock>
                                    <TextBlock Style="{StaticResource InfoKey}" Grid.Row="6" Text="Pasta:" />
                                    <TextBlock Style="{StaticResource InfoValue}" Grid.Row="6" Grid.Column="1" Text="{Binding SavePath}"
                                               ToolTip="{Binding SavePath}" />
                                    <TextBlock Style="{StaticResource InfoKey}" Grid.Row="7" Text="Adicionado:" />
                                    <TextBlock Style="{StaticResource InfoValue}" Grid.Row="7" Grid.Column="1" Text="{Binding AddedText}" />
                                </Grid>
                                <Border Margin="0,8,0,0" BorderBrush="{StaticResource Alert}" BorderThickness="1" Padding="4"
                                        Visibility="{Binding HasRiskyFiles, Converter={StaticResource BoolToVis}}">
                                    <DockPanel>
                                        <Image Source="{a:Pixel Warning}" Width="16" Height="16" VerticalAlignment="Top" Margin="0,0,4,0" />
                                        <TextBlock TextWrapping="Wrap" FontSize="11"
                                                   Text="Contém executáveis. O Itorrent nunca os abre; os arquivos recebem a marca 'baixado da internet' (SmartScreen)." />
                                    </DockPanel>
                                </Border>
                                <TextBlock Margin="0,6,0,0" Foreground="{StaticResource Alert}" TextWrapping="Wrap"
                                           Text="{Binding ErrorMessage}" Visibility="{Binding ErrorMessage, Converter={StaticResource ShowIf}}" />
                            </StackPanel>
                        </Grid>
                    </ScrollViewer>
                </c:ChildWindow>
            </Grid>

            <!-- Grupos minimizados = filtros -->
            <WrapPanel Grid.Row="3" Margin="4,6,4,4">
                <RadioButton Style="{StaticResource GroupIcon}" Content="Todos"
                             IsChecked="{Binding Filter, Converter={StaticResource EnumEquals}, ConverterParameter=All}" />
                <RadioButton Style="{StaticResource GroupIcon}" Content="Baixando"
                             IsChecked="{Binding Filter, Converter={StaticResource EnumEquals}, ConverterParameter=Downloading}" />
                <RadioButton Style="{StaticResource GroupIcon}" Content="Concluídos"
                             IsChecked="{Binding Filter, Converter={StaticResource EnumEquals}, ConverterParameter=Completed}" />
                <RadioButton Style="{StaticResource GroupIcon}" Content="Pausados"
                             IsChecked="{Binding Filter, Converter={StaticResource EnumEquals}, ConverterParameter=Paused}" />
            </WrapPanel>
        </Grid>
    </DockPanel>
</c:RetroWindow>
