<c:RetroWindow x:Class="Itorrent.Desktop.Views.MainWindow"
               xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
               xmlns:l="clr-namespace:Itorrent.Desktop.Localization"
               xmlns:c="clr-namespace:Itorrent.Desktop.Controls"
               xmlns:a="clr-namespace:Itorrent.Desktop.Assets"
               xmlns:vm="clr-namespace:Itorrent.Desktop.ViewModels"
               Title="{l:L App.Title}"
               Width="1060" Height="700" MinWidth="720" MinHeight="460"
               WindowStartupLocation="CenterScreen" AllowDrop="True">
    <c:RetroWindow.Resources>
        <!-- Ícone de grupo minimizado (Gerenciador de Programas) usado como filtro -->
        <Style x:Key="GroupIcon" TargetType="RadioButton">
            <Setter Property="Margin" Value="6,4,14,2" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <StackPanel Width="78" Background="Transparent">
                            <Image Source="{a:Pixel Group}" Width="32" Height="32" />
                            <Border x:Name="Label" HorizontalAlignment="Center" Padding="2,0" Margin="0,2,0,0">
                                <ContentPresenter x:Name="Text" TextBlock.FontSize="11" HorizontalAlignment="Center" />
                            </Border>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Label" Property="Background" Value="{StaticResource Navy}" />
                                <Setter TargetName="Text" Property="TextBlock.Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="InfoKey" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Margin" Value="0,2,8,2" />
        </Style>
        <Style x:Key="InfoValue" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,2" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <Style x:Key="FileAction" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent" Padding="0" BorderThickness="1" BorderBrush="Transparent"
                                VerticalAlignment="Center">
                            <ContentPresenter x:Name="Content" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Shadow}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="Black" />
                                <Setter TargetName="Content" Property="Margin" Value="1,1,-1,-1" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <ContextMenu x:Key="TorrentMenu">
            <MenuItem Header="{l:L Menu.Pause}" Command="{Binding PauseCommand}" />
            <MenuItem Header="{l:L Menu.Resume}" Command="{Binding ResumeCommand}" />
            <MenuItem Header="{l:L Menu.Redownload}" Command="{Binding RedownloadCommand}" />
            <Separator />
            <MenuItem Header="{l:L Menu.OpenFolder}" Command="{Binding OpenFolderCommand}" />
            <Separator />
            <MenuItem Header="{l:L Menu.Remove}" Command="{Binding RemoveCommand}" />
        </ContextMenu>
    </c:RetroWindow.Resources>

    <c:RetroWindow.InputBindings>
        <KeyBinding Key="O" Modifiers="Control" Command="{Binding AddFileCommand}" />
        <KeyBinding Key="M" Modifiers="Control" Command="{Binding AddMagnetCommand}" />
        <KeyBinding Key="V" Modifiers="Control" Command="{Binding AddMagnetCommand}" />
        <KeyBinding Key="Delete" Command="{Binding RemoveCommand}" />
    </c:RetroWindow.InputBindings>

    <DockPanel>
        <!-- ===== Menu ===== -->
        <Border DockPanel.Dock="Top" BorderBrush="Black" BorderThickness="0,0,0,1">
            <Menu>
                <MenuItem Header="{l:L Menu.File}">
                    <MenuItem Header="{l:L Menu.OpenTorrent}" InputGestureText="Ctrl+O" Command="{Binding AddFileCommand}" />
                    <MenuItem Header="{l:L Menu.AddMagnet}" InputGestureText="Ctrl+M" Command="{Binding AddMagnetCommand}" />
                    <Separator />
                    <MenuItem Header="{l:L Menu.HideToTray}" Click="HideToTray_Click" />
                    <MenuItem Header="{l:L Menu.Exit}" Click="Exit_Click" />
                </MenuItem>
                <MenuItem Header="{l:L Menu.Transfers}">
                    <MenuItem Header="{l:L Menu.Pause}" Command="{Binding PauseCommand}" />
                    <MenuItem Header="{l:L Menu.Resume}" Command="{Binding ResumeCommand}" />
                    <MenuItem Header="{l:L Menu.Redownload}" Command="{Binding RedownloadCommand}" />
                    <MenuItem Header="{l:L Menu.Remove}" InputGestureText="Del" Command="{Binding RemoveCommand}" />
                    <MenuItem Header="{l:L Menu.OpenFolder}" Command="{Binding OpenFolderCommand}" />
                    <Separator />
                    <MenuItem Header="{l:L Menu.PauseAll}" Command="{Binding PauseAllCommand}" />
                    <MenuItem Header="{l:L Menu.ResumeAll}" Command="{Binding ResumeAllCommand}" />
                </MenuItem>
                <MenuItem Header="{l:L Menu.Options}">
                    <MenuItem Header="{l:L Menu.Turbo}" IsCheckable="True" IsChecked="{Binding IsTurbo}" />
                    <Separator />
                    <MenuItem Header="{l:L Menu.Settings}" Command="{Binding SettingsCommand}" />
                </MenuItem>
                <MenuItem Header="{l:L Menu.Window}">
                    <MenuItem Header="{l:L Menu.FilterAll}" Command="{Binding FilterCommand}" CommandParameter="{x:Static vm:TorrentFilter.All}" />
                    <MenuItem Header="{l:L Menu.FilterDownloading}" Command="{Binding FilterCommand}" CommandParameter="{x:Static vm:TorrentFilter.Downloading}" />
                    <MenuItem Header="{l:L Menu.FilterCompleted}" Command="{Binding FilterCommand}" CommandParameter="{x:Static vm:TorrentFilter.Completed}" />
                    <MenuItem Header="{l:L Menu.FilterPaused}" Command="{Binding FilterCommand}" CommandParameter="{x:Static vm:TorrentFilter.Paused}" />
                </MenuItem>
                <MenuItem Header="_?">
                    <MenuItem Header="{l:L Menu.About}" Command="{Binding AboutCommand}" />
                </MenuItem>
            </Menu>
        </Border>

        <!-- ===== Barra de ferramentas (estilo eMule) ===== -->
        <Border DockPanel.Dock="Top" Background="{StaticResource Face}" BorderBrush="Black" BorderThickness="0,0,0,1" Padding="5,4">
            <DockPanel>
                <ToggleButton DockPanel.Dock="Right" Style="{StaticResource ToolToggle}" MinWidth="96"
                              IsChecked="{Binding IsTurbo}"
                              ToolTip="{l:L Tool.TurboTip}">
                    <StackPanel>
                        <Image Source="{a:Pixel Turbo}" Width="32" Height="32" />
                        <TextBlock x:Name="TurboText" Text="{Binding TurboLabel}" HorizontalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsTurbo}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource Alert}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </ToggleButton>
                <StackPanel Orientation="Horizontal">
                    <Button Style="{StaticResource ToolButtonB}" Command="{Binding AddFileCommand}" ToolTip="{l:L Tool.OpenTip}">
                        <StackPanel>
                            <Image Source="{a:Pixel TorrentFile}" Width="32" Height="32" />
                            <TextBlock Text="{l:L Tool.Open}" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource ToolButtonB}" Command="{Binding AddMagnetCommand}" ToolTip="{l:L Tool.MagnetTip}">
                        <StackPanel>
                            <Image Source="{a:Pixel Magnet}" Width="32" Height="32" />
                            <TextBlock Text="{l:L Tool.Magnet}" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Rectangle Width="1" Fill="{StaticResource Shadow}" Margin="4,2,6,2" />
                    <Button Style="{StaticResource ToolButtonB}" Command="{Binding ResumeCommand}" ToolTip="{l:L Tool.Resume}">
                        <StackPanel>
                            <Image Source="{a:Pixel Play}" Width="32" Height="32" />
                            <TextBlock Text="{l:L Tool.Resume}" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource ToolButtonB}" Command="{Binding PauseCommand}" ToolTip="{l:L Tool.Pause}">
                        <StackPanel>
                            <Image Source="{a:Pixel Pause}" Width="32" Height="32" />
                            <TextBlock Text="{l:L Tool.Pause}" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource ToolButtonB}" Command="{Binding RemoveCommand}" ToolTip="{l:L Tool.RemoveTip}">
                        <StackPanel>
                            <Image Source="{a:Pixel Remove}" Width="32" Height="32" />
                            <TextBlock Text="{l:L Tool.Remove}" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Rectangle Width="1" Fill="{StaticResource Shadow}" Margin="4,2,6,2" />
                    <Button Style="{StaticResource ToolButtonB}" Command="{Binding OpenFolderCommand}" ToolTip="{l:L Tool.FolderTip}">
                        <StackPanel>
                            <Image Source="{a:Pixel Folder}" Width="32" Height="32" />
                            <TextBlock Text="{l:L Tool.Folder}" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource ToolButtonB}" Command="{Binding SettingsCommand}" ToolTip="{l:L Settings.Title}">
                        <StackPanel>
                            <Image Source="{a:Pixel Settings}" Width="32" Height="32" />
                            <TextBlock Text="{l:L Tool.Options}" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ===== Barra de status ===== -->
        <Border DockPanel.Dock="Bottom" Background="{StaticResource Face}" BorderBrush="Black" BorderThickness="0,1,0,0" Padding="4,3">
            <StackPanel Orientation="Horizontal" TextBlock.FontSize="11">
                <Border Style="{StaticResource StatusPanel}" Width="130">
                    <StackPanel Orientation="Horizontal" Margin="3,1">
                        <Image Source="{a:Pixel Down}" Width="16" Height="16" />
                        <TextBlock Text="{Binding DownText}" VerticalAlignment="Center" Margin="2,0" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource StatusPanel}" Width="130">
                    <StackPanel Orientation="Horizontal" Margin="3,1">
                        <Image Source="{a:Pixel Up}" Width="16" Height="16" />
                        <TextBlock Text="{Binding UpText}" VerticalAlignment="Center" Margin="2,0" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource StatusPanel}" Width="170">
                    <TextBlock Text="{Binding CountText}" Margin="4,2" VerticalAlignment="Center" />
                </Border>
                <Border Style="{StaticResource StatusPanel}" Width="96">
                    <TextBlock Text="{Binding PortText}" Margin="4,2" VerticalAlignment="Center" />
                </Border>
                <Border Style="{StaticResource StatusPanel}" Width="110">
                    <TextBlock Text="{Binding DhtText}" Margin="4,2" VerticalAlignment="Center" />
                </Border>
                <Border Style="{StaticResource StatusPanel}" Width="96">
                    <TextBlock Text="{Binding TurboStatusText}" Margin="4,2" VerticalAlignment="Center" FontWeight="Bold">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsTurbo}" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource Alert}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Border>
            </StackPanel>
        </Border>

        <!-- ===== Área de trabalho ===== -->
        <Grid Background="{StaticResource Workspace}">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" MinHeight="120" />
                <RowDefinition Height="6" />
                <RowDefinition Height="210" MinHeight="90" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Lista de transferências -->
            <c:ChildWindow x:Name="TransfersPanel" Header="{Binding FilterTitle}" Margin="8,8,8,0"
                           IsActive="{Binding IsKeyboardFocusWithin, RelativeSource={RelativeSource Self}}">
                <Grid>
                    <ListView x:Name="TorrentList" ItemsSource="{Binding TorrentsView}" SelectedItem="{Binding Selected}" c:GridSort.Enabled="True"
                              SelectionMode="Single" ContextMenu="{StaticResource TorrentMenu}">
                        <ListView.InputBindings>
                            <MouseBinding Gesture="LeftDoubleClick" Command="{Binding RedownloadCommand}" />
                        </ListView.InputBindings>
                        <ListView.View>
                            <GridView AllowsColumnReorder="False">
                                <GridViewColumn Header="{l:L Col.Name}" c:GridSort.Member="Name" Width="300">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate DataType="vm:TorrentItemViewModel">
                                            <StackPanel Orientation="Horizontal">
                                                <Image Source="{Binding StatusIcon}" Width="16" Height="16" Margin="0,0,4,0" />
                                                <Image Source="{a:Pixel Warning}" Width="16" Height="16" Margin="0,0,4,0"
                                                       ToolTip="{l:L Main.RiskyTip}"
                                                       Visibility="{Binding HasRiskyFiles, Converter={StaticResource BoolToVis}}" />
                                                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="{l:L Col.Size}" c:GridSort.Member="SortSize" Width="78" DisplayMemberBinding="{Binding SizeText}" />
                                <GridViewColumn Header="{l:L Col.Progress}" c:GridSort.Member="Progress" Width="120">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate DataType="vm:TorrentItemViewModel">
                                            <ProgressBar Width="108" Maximum="100" Value="{Binding Progress, Mode=OneWay}" Tag="{Binding ProgressText}" />
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="{l:L Col.Status}" c:GridSort.Member="StatusText" Width="116" DisplayMemberBinding="{Binding StatusText}" />
                                <GridViewColumn c:GridSort.Member="SortDown" Width="96" DisplayMemberBinding="{Binding DownText}">
                                    <GridViewColumn.Header>
                                        <StackPanel Orientation="Horizontal">
                                            <Image Source="{a:Pixel Down}" Width="16" Height="16" Margin="0,0,3,0" />
                                            <TextBlock Text="{l:L Col.Down}" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </GridViewColumn.Header>
                                </GridViewColumn>
                                <GridViewColumn c:GridSort.Member="SortUp" Width="88" DisplayMemberBinding="{Binding UpText}">
                                    <GridViewColumn.Header>
                                        <StackPanel Orientation="Horizontal">
                                            <Image Source="{a:Pixel Up}" Width="16" Height="16" Margin="0,0,3,0" />
                                            <TextBlock Text="{l:L Col.Up}" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </GridViewColumn.Header>
                                </GridViewColumn>
                                <GridViewColumn c:GridSort.Member="SortEta" Width="82" DisplayMemberBinding="{Binding EtaText}">
                                    <GridViewColumn.Header>
                                        <StackPanel Orientation="Horizontal">
                                            <Image Source="{a:Pixel Clock}" Width="16" Height="16" Margin="0,0,3,0" />
                                            <TextBlock Text="{l:L Col.Time}" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </GridViewColumn.Header>
                                </GridViewColumn>
                                <GridViewColumn c:GridSort.Member="SortSeeds" Width="90" DisplayMemberBinding="{Binding SeedsText}">
                                    <GridViewColumn.Header>
                                        <StackPanel Orientation="Horizontal">
                                            <Image Source="{a:Pixel Seed}" Width="16" Height="16" Margin="0,0,3,0" />
                                            <TextBlock Text="{l:L Col.Seeds}" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </GridViewColumn.Header>
                                </GridViewColumn>
                                <GridViewColumn c:GridSort.Member="SortPeers" Width="90" DisplayMemberBinding="{Binding PeersText}">
                                    <GridViewColumn.Header>
                                        <StackPanel Orientation="Horizontal">
                                            <Image Source="{a:Pixel Peers}" Width="16" Height="16" Margin="0,0,3,0" />
                                            <TextBlock Text="{l:L Col.Peers}" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </GridViewColumn.Header>
                                </GridViewColumn>
                                <GridViewColumn c:GridSort.Member="SortAdded" Width="128" DisplayMemberBinding="{Binding AddedText}">
                                    <GridViewColumn.Header>
                                        <StackPanel Orientation="Horizontal">
                                            <Image Source="{a:Pixel Calendar}" Width="16" Height="16" Margin="0,0,3,0" />
                                            <TextBlock Text="{l:L Col.Added}" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </GridViewColumn.Header>
                                </GridViewColumn>
                            </GridView>
                        </ListView.View>
                    </ListView>
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"
                                Visibility="{Binding Torrents.Count, Converter={StaticResource HideIf}, ConverterParameter=0}"
                                x:Name="EmptyHint">
                        <Image Source="{a:Pixel Magnet}" Width="48" Height="48" Opacity="0.7" />
                        <TextBlock Text="{l:L Main.Empty}" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,6,0,2" />
                        <TextBlock Text="{l:L Main.EmptyHint}"
                                   Foreground="{StaticResource Shadow}" HorizontalAlignment="Center" />
                    </StackPanel>
                </Grid>
            </c:ChildWindow>

            <GridSplitter Grid.Row="1" HorizontalAlignment="Stretch" ResizeDirection="Rows" />

            <!-- Detalhes: arquivos + informações -->
            <Grid Grid.Row="2" Margin="8,0,8,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="6" />
                    <ColumnDefinition Width="300" />
                </Grid.ColumnDefinitions>

                <c:ChildWindow Header="{Binding DetailsTitle}"
                               IsActive="{Binding IsKeyboardFocusWithin, RelativeSource={RelativeSource Self}}">
                    <Grid>
                        <ListView ItemsSource="{Binding Files}" c:GridSort.Enabled="True">
                            <ListView.View>
                                <GridView AllowsColumnReorder="False">
                                    <GridViewColumn Header="{l:L Col.Get}" c:GridSort.Member="IsSelected" Width="64">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate DataType="vm:FileItemViewModel">
                                                <CheckBox IsChecked="{Binding IsSelected, Mode=OneWay}" HorizontalAlignment="Center"
                                                          Margin="0" ToolTip="{l:L File.GetTip}"
                                                          Command="{Binding DataContext.ToggleFileCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                          CommandParameter="{Binding}" />
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Header="{l:L Col.File}" c:GridSort.Member="Path" Width="290">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate DataType="vm:FileItemViewModel">
                                                <StackPanel Orientation="Horizontal">
                                                    <Image Source="{Binding Icon}" Width="16" Height="16" Margin="0,0,4,0" />
                                                    <TextBlock Text="{Binding Path}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Header="{l:L Col.Size}" c:GridSort.Member="SortSize" Width="78" DisplayMemberBinding="{Binding SizeText}" />
                                    <GridViewColumn Header="{l:L Col.Progress}" c:GridSort.Member="Progress" Width="112">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate DataType="vm:FileItemViewModel">
                                                <ProgressBar Width="100" Maximum="100" Value="{Binding Progress, Mode=OneWay}" Tag="{Binding ProgressText}">
                                                    <ProgressBar.Style>
                                                        <Style TargetType="ProgressBar" BasedOn="{StaticResource {x:Type ProgressBar}}">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsDeleted}" Value="True">
                                                                    <Setter Property="Background" Value="#FFFFE1" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </ProgressBar.Style>
                                                </ProgressBar>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Header="{l:L Col.Alert}" c:GridSort.Member="RiskText" Width="100" DisplayMemberBinding="{Binding RiskText}" />
                                    <GridViewColumn Header="" Width="34">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate DataType="vm:FileItemViewModel">
                                                <Button Style="{StaticResource FileAction}" ToolTip="{l:L File.DeleteTip}" HorizontalAlignment="Center"
                                                        Visibility="{Binding CanDelete, Converter={StaticResource BoolToVis}}"
                                                        Command="{Binding DataContext.DeleteFileCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}">
                                                    <Image Source="{a:Pixel Trash}" Width="16" Height="16" />
                                                </Button>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </Grid>
                </c:ChildWindow>

                <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" ResizeDirection="Columns" />

                <c:ChildWindow Grid.Column="2" Header="{l:L Main.Info}"
                               IsActive="{Binding IsKeyboardFocusWithin, RelativeSource={RelativeSource Self}}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="8,6">
                        <Grid>
                            <TextBlock Text="{l:L Main.SelectHint}" Foreground="{StaticResource Shadow}"
                                       Visibility="{Binding Selected, Converter={StaticResource HideIf}}" />
                            <StackPanel DataContext="{Binding Selected}" Visibility="{Binding Converter={StaticResource ShowIf}}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                                        <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                                    </Grid.RowDefinitions>
                                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,2,8,2">
                                        <Image Source="{a:Pixel Info}" Width="16" Height="16" Margin="0,0,3,0" />
                                        <TextBlock Style="{StaticResource InfoKey}" Margin="0" Text="{l:L Info.Status}" />
                                    </StackPanel>
                                    <TextBlock Style="{StaticResource InfoValue}" Grid.Column="1" Text="{Binding StatusText}" />
                                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,2,8,2">
                                        <Image Source="{a:Pixel File}" Width="16" Height="16" Margin="0,0,3,0" />
                                        <TextBlock Style="{StaticResource InfoKey}" Margin="0" Text="{l:L Info.Downloaded}" />
                                    </StackPanel>
                                    <TextBlock Style="{StaticResource InfoValue}" Grid.Row="1" Grid.Column="1" Text="{Binding DownloadedText}" />
                                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,2,8,2">
                                        <Image Source="{a:Pixel Hourglass}" Width="16" Height="16" Margin="0,0,3,0" />
                                        <TextBlock Style="{StaticResource InfoKey}" Margin="0" Text="{l:L Info.Progress}" />
                                    </StackPanel>
                                    <ProgressBar Grid.Row="2" Grid.Column="1" Maximum="100" Margin="0,2"
                                                 Value="{Binding Progress, Mode=OneWay}" Tag="{Binding ProgressText}" />
                                    <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,2,8,2">
                                        <Image Source="{a:Pixel Down}" Width="16" Height="16" Margin="0,0,3,0" />
                                        <TextBlock Style="{StaticResource InfoKey}" Margin="0" Text="{l:L Info.Speed}" />
                                    </StackPanel>
                                    <TextBlock Style="{StaticResource InfoValue}" Grid.Row="3" Grid.Column="1">
                                        <InlineUIContainer BaselineAlignment="Center"><Image Source="{a:Pixel Down}" Width="16" Height="16" /></InlineUIContainer><Run Text="{Binding DownText, Mode=OneWay}" />
                                        <Run Text="  " /><InlineUIContainer BaselineAlignment="Center"><Image Source="{a:Pixel Up}" Width="16" Height="16" /></InlineUIContainer><Run Text="{Binding UpText, Mode=OneWay}" />
                                    </TextBlock>
                                    <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,2,8,2">
                                        <Image Source="{a:Pixel Clock}" Width="16" Height="16" Margin="0,0,3,0" />
                                        <TextBlock Style="{StaticResource InfoKey}" Margin="0" Text="{l:L Info.Eta}" />
                                    </StackPanel>
                                    <TextBlock Style="{StaticResource InfoValue}" Grid.Row="4" Grid.Column="1" Text="{Binding EtaText}" />
                                    <StackPanel Grid.Row="5" Orientation="Horizontal" Margin="0,2,8,2">
                                        <Image Source="{a:Pixel Seed}" Width="16" Height="16" Margin="0,0,3,0" />
                                        <TextBlock Style="{StaticResource InfoKey}" Margin="0" Text="{l:L Info.Seeds}" />
                                    </StackPanel>
                                    <TextBlock Style="{StaticResource InfoValue}" Grid.Row="5" Grid.Column="1"
                                               ToolTip="{l:L Info.SeedsTip}">
                                        <Run Text="{Binding SeedsText, Mode=OneWay}" /><Run Text="   " /><InlineUIContainer BaselineAlignment="Center"><Image Source="{a:Pixel Peers}" Width="16" Height="16" Margin="0,0,3,0" /></InlineUIContainer><Run Text="{l:L Info.Peers}" FontWeight="Bold" /><Run Text="{Binding PeersText, Mode=OneWay}" />
                                    </TextBlock>
                                    <StackPanel Grid.Row="6" Orientation="Horizontal" Margin="0,2,8,2">
                                        <Image Source="{a:Pixel Folder}" Width="16" Height="16" Margin="0,0,3,0" />
                                        <TextBlock Style="{StaticResource InfoKey}" Margin="0" Text="{l:L Info.Folder}" />
                                    </StackPanel>
                                    <TextBlock Style="{StaticResource InfoValue}" Grid.Row="6" Grid.Column="1" Text="{Binding SavePath}"
                                               ToolTip="{Binding SavePath}" />
                                    <StackPanel Grid.Row="7" Orientation="Horizontal" Margin="0,2,8,2">
                                        <Image Source="{a:Pixel Calendar}" Width="16" Height="16" Margin="0,0,3,0" />
                                        <TextBlock Style="{StaticResource InfoKey}" Margin="0" Text="{l:L Info.Added}" />
                                    </StackPanel>
                                    <TextBlock Style="{StaticResource InfoValue}" Grid.Row="7" Grid.Column="1" Text="{Binding AddedText}" />
                                </Grid>
                                <Border Margin="0,8,0,0" BorderBrush="{StaticResource Alert}" BorderThickness="1" Padding="4"
                                        Visibility="{Binding HasRiskyFiles, Converter={StaticResource BoolToVis}}">
                                    <DockPanel>
                                        <Image Source="{a:Pixel Warning}" Width="16" Height="16" VerticalAlignment="Top" Margin="0,0,4,0" />
                                        <TextBlock TextWrapping="Wrap" FontSize="11"
                                                   Text="{l:L Info.Risky}" />
                                    </DockPanel>
                                </Border>
                                <Button Margin="0,10,0,0" HorizontalAlignment="Left" Padding="8,2"
                                        Content="{l:L Menu.Redownload}"
                                        Command="{Binding DataContext.RedownloadCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                                <TextBlock Margin="0,6,0,0" Foreground="{StaticResource Alert}" TextWrapping="Wrap"
                                           Text="{Binding ErrorMessage}" Visibility="{Binding ErrorMessage, Converter={StaticResource ShowIf}}" />
                            </StackPanel>
                        </Grid>
                    </ScrollViewer>
                </c:ChildWindow>
            </Grid>

            <!-- Grupos minimizados = filtros -->
            <WrapPanel Grid.Row="3" Margin="4,6,4,4">
                <RadioButton Style="{StaticResource GroupIcon}" Content="{l:L Group.All}"
                             IsChecked="{Binding Filter, Converter={StaticResource EnumEquals}, ConverterParameter=All}" />
                <RadioButton Style="{StaticResource GroupIcon}" Content="{l:L Group.Downloading}"
                             IsChecked="{Binding Filter, Converter={StaticResource EnumEquals}, ConverterParameter=Downloading}" />
                <RadioButton Style="{StaticResource GroupIcon}" Content="{l:L Group.Completed}"
                             IsChecked="{Binding Filter, Converter={StaticResource EnumEquals}, ConverterParameter=Completed}" />
                <RadioButton Style="{StaticResource GroupIcon}" Content="{l:L Group.Paused}"
                             IsChecked="{Binding Filter, Converter={StaticResource EnumEquals}, ConverterParameter=Paused}" />
            </WrapPanel>
        </Grid>
    </DockPanel>
</c:RetroWindow>
