<c:RetroWindow x:Class="Itorrent.Desktop.Views.SettingsDialog"
               xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
               xmlns:l="clr-namespace:Itorrent.Desktop.Localization"
               xmlns:c="clr-namespace:Itorrent.Desktop.Controls"
               xmlns:a="clr-namespace:Itorrent.Desktop.Assets"
               Title="{l:L Settings.Title}" IsDialog="True" ResizeMode="NoResize"
               Width="640" SizeToContent="Height"
               WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <c:RetroWindow.Resources>
        <Style x:Key="Num" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Width" Value="70" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="Margin" Value="0,2" />
        </Style>
        <Style x:Key="Row" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,2,8,2" />
        </Style>
    </c:RetroWindow.Resources>

    <StackPanel Margin="12,10,12,12">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel>
                <GroupBox Header="{l:L Settings.Downloads}">
                    <StackPanel>
                        <TextBlock Text="{l:L Settings.DefaultFolder}" FontWeight="Bold" Margin="0,0,0,2" />
                        <DockPanel Margin="0,0,0,6">
                            <Button DockPanel.Dock="Right" Content="..." Command="{Binding BrowseCommand}" Padding="6,1" Margin="4,0,0,0" />
                            <TextBox Text="{Binding DefaultSavePath, UpdateSourceTrigger=PropertyChanged}" />
                        </DockPanel>
                        <CheckBox Content="{l:L Settings.StopSeeding}" IsChecked="{Binding StopSeedingOnComplete}"
                                  ToolTip="{l:L Settings.StopSeedingTip}" />
                        <CheckBox Content="{l:L Settings.Notify}" IsChecked="{Binding NotifyOnComplete}" />
                        <CheckBox Content="{l:L Settings.PreventSleep}" IsChecked="{Binding PreventSleepWhileDownloading}" />
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="{l:L Settings.Speed}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                        </Grid.RowDefinitions>
                        <TextBlock Style="{StaticResource Row}" Text="{l:L Settings.MaxDown}" />
                        <TextBox Grid.Column="1" Style="{StaticResource Num}" Text="{Binding MaxDownloadKBps}" />
                        <TextBlock Style="{StaticResource Row}" Grid.Row="1" Text="{l:L Settings.MaxUp}" />
                        <TextBox Grid.Row="1" Grid.Column="1" Style="{StaticResource Num}" Text="{Binding MaxUploadKBps}" />
                        <TextBlock Style="{StaticResource Row}" Grid.Row="2" Text="{l:L Settings.Conns}" />
                        <TextBox Grid.Row="2" Grid.Column="1" Style="{StaticResource Num}" Text="{Binding MaxConnectionsPerTorrent}" />
                        <TextBlock Style="{StaticResource Row}" Grid.Row="3" Text="{l:L Settings.TurboConns}" />
                        <TextBox Grid.Row="3" Grid.Column="1" Style="{StaticResource Num}" Text="{Binding TurboConnectionsPerTorrent}" />
                    </Grid>
                </GroupBox>

                <GroupBox Header="{l:L Settings.OnClose}">
                    <StackPanel>
                        <TextBlock Text="{l:L Settings.CloseClick}" FontWeight="Bold" Margin="0,0,0,2" />
                        <StackPanel Margin="8,0,0,6">
                            <RadioButton GroupName="CloseAction" Content="{l:L Settings.KeepBackground}"
                                         IsChecked="{Binding MinimizeToTrayOnClose, Converter={StaticResource EnumEquals}, ConverterParameter=True}" />
                            <RadioButton GroupName="CloseAction" Content="{l:L Settings.CloseApp}"
                                         IsChecked="{Binding MinimizeToTrayOnClose, Converter={StaticResource EnumEquals}, ConverterParameter=False}" />
                        </StackPanel>
                        <TextBlock Text="{l:L Settings.AutoExit}" FontWeight="Bold" TextWrapping="Wrap" Margin="0,0,0,2" />
                        <WrapPanel Margin="8,0,0,0">
                            <RadioButton GroupName="AutoExit" Content="{l:L Settings.Min30}" Margin="0,2,12,2"
                                         IsChecked="{Binding AutoExitIdleMinutes, Converter={StaticResource EnumEquals}, ConverterParameter=30}" />
                            <RadioButton GroupName="AutoExit" Content="{l:L Settings.H2}" Margin="0,2,12,2"
                                         IsChecked="{Binding AutoExitIdleMinutes, Converter={StaticResource EnumEquals}, ConverterParameter=120}" />
                            <RadioButton GroupName="AutoExit" Content="{l:L Settings.H3}" Margin="0,2,12,2"
                                         IsChecked="{Binding AutoExitIdleMinutes, Converter={StaticResource EnumEquals}, ConverterParameter=180}" />
                            <RadioButton GroupName="AutoExit" Content="{l:L Settings.Never}" Margin="0,2,12,2"
                                         IsChecked="{Binding AutoExitIdleMinutes, Converter={StaticResource EnumEquals}, ConverterParameter=0}" />
                        </WrapPanel>
                        <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource Shadow}" Margin="0,4,0,0"
                                   Text="{l:L Settings.AutoExitHint}" />
                    </StackPanel>
                </GroupBox>
            </StackPanel>

            <StackPanel Grid.Column="2">
                <GroupBox Header="{l:L Settings.Language}">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton GroupName="Language" Content="Português (Brasil)" Margin="0,2,20,2"
                                     IsChecked="{Binding Language, Converter={StaticResource EnumEquals}, ConverterParameter=pt-BR}" />
                        <RadioButton GroupName="Language" Content="English" Margin="0,2"
                                     IsChecked="{Binding Language, Converter={StaticResource EnumEquals}, ConverterParameter=en}" />
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="{l:L Settings.Connection}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <TextBlock Style="{StaticResource Row}" Text="{l:L Settings.Port}" />
                            <TextBox Style="{StaticResource Num}" Text="{Binding ListenPort}" />
                        </StackPanel>
                        <CheckBox Content="{l:L Settings.Upnp}" IsChecked="{Binding AllowPortForwarding}" />
                        <CheckBox Content="{l:L Settings.Dht}" IsChecked="{Binding AllowDht}" />
                        <CheckBox Content="{l:L Settings.Pex}" IsChecked="{Binding AllowPeerExchange}" />
                        <CheckBox Content="{l:L Settings.Lpd}" IsChecked="{Binding AllowLocalPeerDiscovery}" />
                        <CheckBox Content="{l:L Settings.PublicTrackers}" IsChecked="{Binding AddPublicTrackers}" />
                        <Border Margin="0,6,0,0" BorderBrush="Black" BorderThickness="1" Background="White" Padding="4">
                            <DockPanel>
                                <Image Source="{a:Pixel Turbo}" Width="16" Height="16" VerticalAlignment="Top" Margin="0,0,4,0" />
                                <StackPanel>
                                    <CheckBox Content="{l:L Settings.Turbo}" FontWeight="Bold" IsChecked="{Binding TurboMode}" Margin="0" />
                                    <TextBlock TextWrapping="Wrap" FontSize="11" Margin="0,2,0,0"
                                               Text="{l:L Settings.TurboHint}" />
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="{l:L Settings.System}">
                    <StackPanel>
                        <CheckBox Content="{l:L Settings.StartWithWindows}" IsChecked="{Binding StartWithWindows}" />
                        <Button Content="{l:L Settings.Associate}" Command="{Binding AssociateCommand}"
                                HorizontalAlignment="Left" Margin="0,6,0,2" Padding="8,2" />
                        <TextBlock Text="{Binding AssociationText}" FontSize="11" TextWrapping="Wrap" Foreground="{StaticResource Shadow}" />
                    </StackPanel>
                </GroupBox>
            </StackPanel>
        </Grid>

        <TextBlock Text="{Binding Error}" Foreground="{StaticResource Alert}" FontWeight="Bold" TextWrapping="Wrap"
                   Visibility="{Binding Error, Converter={StaticResource ShowIf}}" Margin="0,0,0,6" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="{l:L Common.Ok}" IsDefault="True" Width="96" Margin="0,0,8,0" Click="Ok_Click" />
            <Button Content="{l:L Common.Cancel}" IsCancel="True" Width="96" />
        </StackPanel>
    </StackPanel>
</c:RetroWindow>
