<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:c="clr-namespace:Itorrent.Desktop.Controls"
                    xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework">

    <!-- ===== Paleta Windows 3.1 ===== -->
    <Color x:Key="FaceColor">#C0C0C0</Color>
    <SolidColorBrush x:Key="Face" Color="#C0C0C0" />
    <SolidColorBrush x:Key="Shadow" Color="#808080" />
    <SolidColorBrush x:Key="Light" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Ink" Color="#000000" />
    <SolidColorBrush x:Key="Navy" Color="#000080" />
    <SolidColorBrush x:Key="Teal" Color="#008080" />
    <SolidColorBrush x:Key="Workspace" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Disabled" Color="#808080" />
    <SolidColorBrush x:Key="Alert" Color="#800000" />

    <!-- Pontilhado dos botões travados (toggle ligado) -->
    <DrawingBrush x:Key="Dither" TileMode="Tile" Viewport="0,0,2,2" ViewportUnits="Absolute" RenderOptions.EdgeMode="Aliased">
        <DrawingBrush.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="#C0C0C0" Geometry="M0,0 H2 V2 H0Z" />
                <GeometryDrawing Brush="#FFFFFF" Geometry="M0,0 H1 V1 H0Z M1,1 H2 V2 H1Z" />
            </DrawingGroup>
        </DrawingBrush.Drawing>
    </DrawingBrush>

    <FontFamily x:Key="RetroFont">Microsoft Sans Serif, MS Sans Serif, Tahoma</FontFamily>
    <FontFamily x:Key="MonoFont">Fixedsys, Courier New</FontFamily>

    <!-- Retângulo pontilhado de foco -->
    <Style x:Key="RetroFocus">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Rectangle Margin="4" Stroke="Black" StrokeThickness="1" StrokeDashArray="1 1" SnapsToDevicePixels="True" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Botão em relevo ===== -->
    <Style TargetType="ButtonBase" x:Key="RetroButtonBase">
        <Setter Property="Background" Value="{StaticResource Face}" />
        <Setter Property="Foreground" Value="{StaticResource Ink}" />
        <Setter Property="FontFamily" Value="{StaticResource RetroFont}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Padding" Value="12,3" />
        <Setter Property="MinWidth" Value="24" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource RetroFocus}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ButtonBase">
                    <Border x:Name="Outer" BorderBrush="{StaticResource Ink}" BorderThickness="1" CornerRadius="2"
                            Background="{TemplateBinding Background}">
                        <Grid>
                            <Border x:Name="ShadowEdge" BorderBrush="{StaticResource Shadow}" BorderThickness="0,0,2,2" />
                            <Border x:Name="LightEdge" BorderBrush="{StaticResource Light}" BorderThickness="2,2,0,0" Margin="0,0,1,1" />
                            <ContentPresenter x:Name="Content" Margin="{TemplateBinding Padding}" RecognizesAccessKey="True"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}">
                                <ContentPresenter.RenderTransform>
                                    <TranslateTransform x:Name="Shift" />
                                </ContentPresenter.RenderTransform>
                            </ContentPresenter>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="LightEdge" Property="BorderBrush" Value="{StaticResource Shadow}" />
                            <Setter TargetName="LightEdge" Property="BorderThickness" Value="1,1,0,0" />
                            <Setter TargetName="ShadowEdge" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="Content" Property="RenderTransform">
                                <Setter.Value>
                                    <TranslateTransform X="1" Y="1" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="ToggleButton.IsChecked" Value="True">
                            <Setter TargetName="LightEdge" Property="BorderBrush" Value="{StaticResource Shadow}" />
                            <Setter TargetName="LightEdge" Property="BorderThickness" Value="1,1,0,0" />
                            <Setter TargetName="ShadowEdge" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="Outer" Property="Background" Value="{StaticResource Dither}" />
                            <Setter TargetName="Content" Property="RenderTransform">
                                <Setter.Value>
                                    <TranslateTransform X="1" Y="1" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="Button.IsDefault" Value="True">
                            <Setter TargetName="Outer" Property="BorderThickness" Value="2" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource Disabled}" />
                            <Setter TargetName="Content" Property="Opacity" Value="0.55" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="Button" BasedOn="{StaticResource RetroButtonBase}" />
    <Style TargetType="ToggleButton" BasedOn="{StaticResource RetroButtonBase}" />
    <Style TargetType="RepeatButton" BasedOn="{StaticResource RetroButtonBase}" />

    <!-- Botões grandes da barra de ferramentas (ícone + texto embaixo) -->
    <Style x:Key="ToolButton" TargetType="ButtonBase" BasedOn="{StaticResource RetroButtonBase}">
        <Setter Property="Padding" Value="4,3,4,2" />
        <Setter Property="Margin" Value="0,0,3,0" />
        <Setter Property="MinWidth" Value="62" />
        <Setter Property="Height" Value="58" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Focusable" Value="False" />
    </Style>
    <Style TargetType="Button" x:Key="ToolButtonB" BasedOn="{StaticResource ToolButton}" />
    <Style TargetType="ToggleButton" x:Key="ToolToggle" BasedOn="{StaticResource ToolButton}" />

    <!-- Imagem pixelada -->
    <Style TargetType="Image">
        <Setter Property="RenderOptions.BitmapScalingMode" Value="NearestNeighbor" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Stretch" Value="Uniform" />
    </Style>

    <!-- ===== Caixa de texto (borda preta simples, como no 3.1) ===== -->
    <Style TargetType="TextBox">
        <Setter Property="FontFamily" Value="{StaticResource RetroFont}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Background" Value="White" />
        <Setter Property="Foreground" Value="Black" />
        <Setter Property="BorderBrush" Value="Black" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="2,2" />
        <Setter Property="SelectionBrush" Value="{StaticResource Navy}" />
        <Setter Property="SelectionOpacity" Value="1" />
        <Setter Property="SelectionTextBrush" Value="White" />
        <Setter Property="CaretBrush" Value="Black" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" SnapsToDevicePixels="True">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource Disabled}" />
                        </Trigger>
                        <Trigger Property="IsReadOnly" Value="True">
                            <Setter Property="Background" Value="{StaticResource Face}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== CheckBox com X ===== -->
    <Style TargetType="CheckBox">
        <Setter Property="FontFamily" Value="{StaticResource RetroFont}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="Black" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Margin" Value="0,2" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border x:Name="Box" Width="13" Height="13" Background="White" BorderBrush="Black" BorderThickness="1"
                                VerticalAlignment="Center" SnapsToDevicePixels="True">
                            <Grid>
                                <Path x:Name="Cross" Data="M0,0 L9,9 M9,0 L0,9" Stroke="Black" StrokeThickness="1.3"
                                      Margin="1" Stretch="Fill" Visibility="Collapsed" SnapsToDevicePixels="True" />
                                <Rectangle x:Name="Partial" Fill="{StaticResource Shadow}" Margin="2" Visibility="Collapsed" />
                            </Grid>
                        </Border>
                        <Border x:Name="FocusRect" Grid.Column="1" Margin="4,0,0,0" Padding="1,0" BorderThickness="0"
                                VerticalAlignment="Center">
                            <ContentPresenter RecognizesAccessKey="True" VerticalAlignment="Center" />
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Cross" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="{x:Null}">
                            <Setter TargetName="Partial" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="FocusRect" Property="BorderBrush" Value="Black" />
                            <Setter TargetName="FocusRect" Property="BorderThickness" Value="1" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Box" Property="BorderThickness" Value="2" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource Disabled}" />
                            <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Disabled}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Botão de opção (círculo com ponto preto) ===== -->
    <Style TargetType="RadioButton">
        <Setter Property="FontFamily" Value="{StaticResource RetroFont}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="Black" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Margin" Value="0,2" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid Width="13" Height="13" VerticalAlignment="Center">
                            <Ellipse x:Name="Ring" Fill="White" Stroke="Black" StrokeThickness="1" />
                            <Ellipse x:Name="Dot" Width="5" Height="5" Fill="Black" Visibility="Collapsed" />
                        </Grid>
                        <Border x:Name="FocusRect" Grid.Column="1" Margin="4,0,0,0" Padding="1,0" BorderBrush="Black"
                                BorderThickness="0" VerticalAlignment="Center">
                            <ContentPresenter RecognizesAccessKey="True" VerticalAlignment="Center" />
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Dot" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="FocusRect" Property="BorderThickness" Value="1" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Ring" Property="StrokeThickness" Value="2" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource Disabled}" />
                            <Setter TargetName="Ring" Property="Stroke" Value="{StaticResource Disabled}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Barras de rolagem estilo 3.1 ===== -->
    <Style x:Key="ScrollArrow" TargetType="RepeatButton" BasedOn="{StaticResource RetroButtonBase}">
        <Setter Property="Padding" Value="0" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
    </Style>
    <Style x:Key="ScrollThumb" TargetType="Thumb">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border BorderBrush="Black" BorderThickness="1" Background="{StaticResource Face}">
                        <Grid>
                            <Border BorderBrush="{StaticResource Shadow}" BorderThickness="0,0,1,1" />
                            <Border BorderBrush="White" BorderThickness="1,1,0,0" Margin="0,0,1,1" />
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="ScrollTrack" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Rectangle Fill="{StaticResource Face}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="ScrollBar">
        <Setter Property="Width" Value="17" />
        <Setter Property="MinWidth" Value="17" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Border BorderBrush="Black" BorderThickness="1,0,0,0" Background="{StaticResource Face}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="17" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="17" />
                            </Grid.RowDefinitions>
                            <RepeatButton Style="{StaticResource ScrollArrow}" Command="ScrollBar.LineUpCommand">
                                <Path Data="M0,4 L4,0 L8,4 Z" Fill="Black" />
                            </RepeatButton>
                            <Track x:Name="PART_Track" Grid.Row="1" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource ScrollTrack}" Command="ScrollBar.PageUpCommand" />
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource ScrollThumb}" Height="17" />
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource ScrollTrack}" Command="ScrollBar.PageDownCommand" />
                                </Track.IncreaseRepeatButton>
                            </Track>
                            <RepeatButton Grid.Row="2" Style="{StaticResource ScrollArrow}" Command="ScrollBar.LineDownCommand">
                                <Path Data="M0,0 L8,0 L4,4 Z" Fill="Black" />
                            </RepeatButton>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="Height" Value="17" />
                <Setter Property="MinHeight" Value="17" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Border BorderBrush="Black" BorderThickness="0,1,0,0" Background="{StaticResource Face}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="17" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="17" />
                                    </Grid.ColumnDefinitions>
                                    <RepeatButton Style="{StaticResource ScrollArrow}" Command="ScrollBar.LineLeftCommand">
                                        <Path Data="M4,0 L0,4 L4,8 Z" Fill="Black" />
                                    </RepeatButton>
                                    <Track x:Name="PART_Track" Grid.Column="1">
                                        <Track.DecreaseRepeatButton>
                                            <RepeatButton Style="{StaticResource ScrollTrack}" Command="ScrollBar.PageLeftCommand" />
                                        </Track.DecreaseRepeatButton>
                                        <Track.Thumb>
                                            <Thumb Style="{StaticResource ScrollThumb}" Width="17" />
                                        </Track.Thumb>
                                        <Track.IncreaseRepeatButton>
                                            <RepeatButton Style="{StaticResource ScrollTrack}" Command="ScrollBar.PageRightCommand" />
                                        </Track.IncreaseRepeatButton>
                                    </Track>
                                    <RepeatButton Grid.Column="2" Style="{StaticResource ScrollArrow}" Command="ScrollBar.LineRightCommand">
                                        <Path Data="M0,0 L4,4 L0,8 Z" Fill="Black" />
                                    </RepeatButton>
                                </Grid>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ===== Menus: fundo branco, destaque azul-marinho, sombra preta ===== -->
    <Style TargetType="Menu">
        <Setter Property="Background" Value="White" />
        <Setter Property="FontFamily" Value="{StaticResource RetroFont}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Padding" Value="2,1" />
    </Style>

    <Style x:Key="{x:Static MenuItem.SeparatorStyleKey}" TargetType="Separator">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Separator">
                    <Rectangle Height="1" Fill="Black" Margin="0,3" SnapsToDevicePixels="True" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="MenuItem">
        <Setter Property="Foreground" Value="Black" />
        <Setter Property="FontFamily" Value="{StaticResource RetroFont}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Border x:Name="Bd" Background="Transparent" Padding="7,2" SnapsToDevicePixels="True">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition x:Name="CheckCol" Width="0" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" SharedSizeGroup="Gesture" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="Check" Text="✓" Visibility="Hidden" VerticalAlignment="Center" />
                            <ContentPresenter Grid.Column="1" ContentSource="Header" RecognizesAccessKey="True" VerticalAlignment="Center" />
                            <TextBlock x:Name="Gesture" Grid.Column="2" Text="{TemplateBinding InputGestureText}" Margin="24,0,0,0"
                                       Visibility="Collapsed" VerticalAlignment="Center" />
                            <Path x:Name="Arrow" Grid.Column="3" Data="M0,0 L4,4 L0,8 Z" Fill="{TemplateBinding Foreground}"
                                  Margin="10,0,0,0" VerticalAlignment="Center" Visibility="Collapsed" />
                            <Popup x:Name="PART_Popup" Placement="Bottom" AllowsTransparency="True" Focusable="False"
                                   PopupAnimation="None" HorizontalOffset="-7" VerticalOffset="2"
                                   IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}">
                                <Grid Margin="0,0,3,3">
                                    <Border Background="Black" Margin="3,3,-3,-3" />
                                    <Border Background="White" BorderBrush="Black" BorderThickness="1" Padding="0,2">
                                        <StackPanel IsItemsHost="True" Grid.IsSharedSizeScope="True"
                                                    KeyboardNavigation.DirectionalNavigation="Cycle" />
                                    </Border>
                                </Grid>
                            </Popup>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Role" Value="SubmenuItem">
                            <Setter TargetName="Bd" Property="Padding" Value="4,3,16,3" />
                            <Setter TargetName="CheckCol" Property="Width" Value="18" />
                            <Setter TargetName="Gesture" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="Role" Value="SubmenuHeader">
                            <Setter TargetName="Bd" Property="Padding" Value="4,3,8,3" />
                            <Setter TargetName="CheckCol" Property="Width" Value="18" />
                            <Setter TargetName="Arrow" Property="Visibility" Value="Visible" />
                            <Setter TargetName="PART_Popup" Property="Placement" Value="Right" />
                            <Setter TargetName="PART_Popup" Property="HorizontalOffset" Value="0" />
                            <Setter TargetName="PART_Popup" Property="VerticalOffset" Value="-3" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Check" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Navy}" />
                            <Setter Property="Foreground" Value="White" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource Disabled}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ContextMenu">
        <Setter Property="FontFamily" Value="{StaticResource RetroFont}" />
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="HasDropShadow" Value="False" />
        <Setter Property="Grid.IsSharedSizeScope" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContextMenu">
                    <Grid Margin="0,0,3,3">
                        <Border Background="Black" Margin="3,3,-3,-3" />
                        <Border Background="White" BorderBrush="Black" BorderThickness="1" Padding="0,2">
                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" />
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Lista (ListView + GridView) ===== -->
    <Style TargetType="GridViewColumnHeader">
        <Setter Property="FontFamily" Value="{StaticResource RetroFont}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="GridViewColumnHeader">
                    <Grid>
                        <Border x:Name="Bd" Background="{StaticResource Face}" BorderBrush="Black" BorderThickness="0,0,1,1">
                            <Grid>
                                <Border BorderBrush="{StaticResource Shadow}" BorderThickness="0,0,1,1" />
                                <Border BorderBrush="White" BorderThickness="1,1,0,0" Margin="0,0,1,1" />
                                <ContentPresenter Margin="5,3,5,3" RecognizesAccessKey="True"
                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <Thumb x:Name="PART_HeaderGripper" HorizontalAlignment="Right" Width="6" Margin="0,0,-3,0">
                            <Thumb.Template>
                                <ControlTemplate TargetType="Thumb">
                                    <Border Background="Transparent" Cursor="SizeWE" />
                                </ControlTemplate>
                            </Thumb.Template>
                        </Thumb>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Shadow}" />
                        </Trigger>
                        <Trigger Property="Role" Value="Padding">
                            <Setter TargetName="PART_HeaderGripper" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ListView">
        <Setter Property="Background" Value="White" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FontFamily" Value="{StaticResource RetroFont}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
        <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
        <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling" />
    </Style>

    <Style TargetType="ListViewItem">
        <Setter Property="Foreground" Value="Black" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListViewItem">
                    <Border x:Name="Bd" Background="Transparent" Padding="0,1" SnapsToDevicePixels="True">
                        <GridViewRowPresenter VerticalAlignment="Center" Columns="{TemplateBinding GridView.ColumnCollection}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Navy}" />
                            <Setter Property="Foreground" Value="White" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Árvore estilo Gerenciador de Arquivos ===== -->
    <Style x:Key="TreeExpander" TargetType="ToggleButton">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border Width="9" Height="9" Background="White" BorderBrush="Black" BorderThickness="1"
                            SnapsToDevicePixels="True">
                        <Path x:Name="Sign" Data="M0,3 H7 M3,0 V7" Stroke="Black" StrokeThickness="1" Margin="0" SnapsToDevicePixels="True"
                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Sign" Property="Data" Value="M0,3 H7" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="TreeView">
        <Setter Property="Background" Value="White" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FontFamily" Value="{StaticResource RetroFont}" />
        <Setter Property="FontSize" Value="12" />
    </Style>

    <Style TargetType="TreeViewItem">
        <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TreeViewItem">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ToggleButton x:Name="Expander" Style="{StaticResource TreeExpander}" ClickMode="Press"
                                          IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <Border x:Name="Bd" Grid.Column="1" Padding="1" HorizontalAlignment="Stretch">
                                <ContentPresenter x:Name="PART_Header" ContentSource="Header" />
                            </Border>
                        </Grid>
                        <ItemsPresenter x:Name="ItemsHost" Margin="16,0,0,0" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsExpanded" Value="False">
                            <Setter TargetName="ItemsHost" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="HasItems" Value="False">
                            <Setter TargetName="Expander" Property="Visibility" Value="Hidden" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Barra de progresso: azul-marinho com texto invertido ===== -->
    <Style TargetType="ProgressBar">
        <Setter Property="Height" Value="15" />
        <Setter Property="Foreground" Value="{StaticResource Navy}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Border x:Name="Root" BorderBrush="Black" BorderThickness="1" Background="White" SnapsToDevicePixels="True">
                        <Grid x:Name="PART_Track">
                            <TextBlock Text="{TemplateBinding Tag}" Foreground="Black" FontSize="11" FontWeight="Bold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <Border x:Name="PART_Indicator" HorizontalAlignment="Left" Background="{TemplateBinding Foreground}"
                                    ClipToBounds="True">
                                <TextBlock Text="{TemplateBinding Tag}" Foreground="White" FontSize="11" FontWeight="Bold"
                                           TextAlignment="Center" VerticalAlignment="Center" HorizontalAlignment="Left"
                                           Width="{Binding ActualWidth, ElementName=PART_Track}" />
                            </Border>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Barra "procurando..." (vai e volta), para quando não há progresso conhecido -->
    <Style x:Key="BusyBar" TargetType="ContentControl">
        <Setter Property="Height" Value="15" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <Border BorderBrush="Black" BorderThickness="1" Background="White" ClipToBounds="True">
                        <Canvas x:Name="Lane">
                            <Rectangle x:Name="Block" Width="60" Height="13" Fill="{StaticResource Navy}">
                                <Rectangle.RenderTransform>
                                    <TranslateTransform />
                                </Rectangle.RenderTransform>
                            </Rectangle>
                        </Canvas>
                    </Border>
                    <ControlTemplate.Triggers>
                        <EventTrigger RoutedEvent="Loaded" SourceName="Block">
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="Block"
                                                     Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                     From="-60" To="420" Duration="0:0:1.8" RepeatBehavior="Forever" AutoReverse="True" />
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== GroupBox com linha preta ===== -->
    <Style TargetType="GroupBox">
        <Setter Property="FontFamily" Value="{StaticResource RetroFont}" />
        <Setter Property="Margin" Value="0,0,0,8" />
        <Setter Property="Padding" Value="8,6,8,6" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="GroupBox">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" Grid.RowSpan="2" Margin="0,7,0,0" BorderBrush="Black" BorderThickness="1" />
                        <Border Grid.Row="0" Background="{StaticResource Face}" HorizontalAlignment="Left" Margin="8,0,0,0" Padding="3,0">
                            <ContentPresenter ContentSource="Header" TextBlock.FontWeight="Bold" RecognizesAccessKey="True" />
                        </Border>
                        <ContentPresenter Grid.Row="1" Margin="{TemplateBinding Padding}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ToolTip">
        <Setter Property="FontFamily" Value="{StaticResource RetroFont}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border Background="#FFFFE1" BorderBrush="Black" BorderThickness="1" Padding="4,2">
                        <ContentPresenter />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="GridSplitter">
        <Setter Property="Background" Value="{StaticResource Workspace}" />
    </Style>

    <!-- ===== Janela-filha (estilo grupo do Gerenciador de Programas) ===== -->
    <Style TargetType="c:ChildWindow">
        <Setter Property="Background" Value="White" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="c:ChildWindow">
                    <Border BorderBrush="Black" BorderThickness="1" Background="{StaticResource Face}" Padding="2">
                        <Border BorderBrush="Black" BorderThickness="1">
                            <DockPanel>
                                <Grid x:Name="Title" DockPanel.Dock="Top" Height="19" Background="{StaticResource Navy}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="19" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Background="{StaticResource Face}" BorderBrush="Black" BorderThickness="0,0,1,0">
                                        <Rectangle Width="11" Height="3" Fill="White" Stroke="Black" StrokeThickness="1"
                                                   VerticalAlignment="Center" HorizontalAlignment="Center" />
                                    </Border>
                                    <TextBlock x:Name="TitleText" Grid.Column="1" Text="{TemplateBinding Header}" Foreground="White"
                                               FontWeight="Bold" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" Margin="4,0" />
                                    <ContentPresenter Grid.Column="2" Content="{TemplateBinding HeaderContent}" />
                                </Grid>
                                <Rectangle DockPanel.Dock="Top" Height="1" Fill="Black" />
                                <Border Background="{TemplateBinding Background}">
                                    <ContentPresenter />
                                </Border>
                            </DockPanel>
                        </Border>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsActive" Value="False">
                            <Setter TargetName="Title" Property="Background" Value="White" />
                            <Setter TargetName="TitleText" Property="Foreground" Value="Black" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Janela principal e diálogos: moldura grossa, título azul centralizado ===== -->
    <Style x:Key="CaptionButton" TargetType="Button" BasedOn="{StaticResource RetroButtonBase}">
        <Setter Property="Width" Value="19" />
        <Setter Property="Height" Value="19" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True" />
    </Style>

    <Style x:Key="RetroWindowStyle" TargetType="c:RetroWindow">
        <Setter Property="FontFamily" Value="{StaticResource RetroFont}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Background" Value="{StaticResource Face}" />
        <Setter Property="Foreground" Value="Black" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
        <Setter Property="TextOptions.TextRenderingMode" Value="Aliased" />
        <Setter Property="shell:WindowChrome.WindowChrome">
            <Setter.Value>
                <shell:WindowChrome CaptionHeight="20" ResizeBorderThickness="5" GlassFrameThickness="0"
                                    CornerRadius="0" UseAeroCaptionButtons="False" />
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="c:RetroWindow">
                    <Border x:Name="Frame" Background="{StaticResource Face}" BorderBrush="Black" BorderThickness="1" Padding="3">
                        <Border BorderBrush="Black" BorderThickness="1">
                            <DockPanel>
                                <Grid x:Name="TitleBar" DockPanel.Dock="Top" Height="20" Background="{StaticResource Navy}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Button x:Name="ControlBox" Style="{StaticResource CaptionButton}" Width="20" Height="20"
                                            BorderThickness="0" Command="{x:Static SystemCommands.ShowSystemMenuCommand}"
                                            ToolTip="Menu de controle (clique duplo fecha)">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{StaticResource Face}" BorderBrush="Black" BorderThickness="0,0,1,0">
                                                    <Grid Width="13" Height="5" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                        <Rectangle Fill="{StaticResource Shadow}" Margin="2,2,0,0" />
                                                        <Rectangle Fill="White" Stroke="Black" StrokeThickness="1" Margin="0,0,2,2" />
                                                    </Grid>
                                                </Border>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                    <TextBlock x:Name="TitleText" Grid.Column="1" Text="{TemplateBinding Title}" Foreground="White"
                                               FontWeight="Bold" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" Margin="6,0" />
                                    <Button x:Name="MinButton" Grid.Column="2" Style="{StaticResource CaptionButton}"
                                            Command="{x:Static SystemCommands.MinimizeWindowCommand}" ToolTip="Minimizar">
                                        <Path Data="M0,0 L8,0 L4,4 Z" Fill="Black" />
                                    </Button>
                                    <Button x:Name="MaxButton" Grid.Column="3" Style="{StaticResource CaptionButton}"
                                            Command="{x:Static SystemCommands.MaximizeWindowCommand}" ToolTip="Maximizar">
                                        <Grid Width="9" Height="9" SnapsToDevicePixels="True">
                                            <!-- Maximizar: uma janela com a barra de título grossa -->
                                            <Canvas x:Name="MaxGlyph">
                                                <Rectangle Width="9" Height="9" Stroke="Black" StrokeThickness="1" />
                                                <Rectangle Width="9" Height="2" Fill="Black" />
                                            </Canvas>
                                            <!-- Restaurar: duas janelas sobrepostas -->
                                            <Canvas x:Name="RestoreGlyph" Visibility="Collapsed">
                                                <Rectangle Canvas.Left="2" Width="7" Height="6" Stroke="Black" StrokeThickness="1" />
                                                <Rectangle Canvas.Left="2" Width="7" Height="2" Fill="Black" />
                                                <Rectangle Canvas.Top="3" Width="7" Height="6" Fill="{StaticResource Face}" Stroke="Black" StrokeThickness="1" />
                                                <Rectangle Canvas.Top="3" Width="7" Height="2" Fill="Black" />
                                            </Canvas>
                                        </Grid>
                                    </Button>
                                    <Button x:Name="CloseButton" Grid.Column="4" Style="{StaticResource CaptionButton}" Margin="2,0,0,0"
                                            Command="{x:Static SystemCommands.CloseWindowCommand}" ToolTip="Fechar">
                                        <Path Data="M0,0 L7,7 M7,0 L0,7" Stroke="Black" StrokeThickness="2" />
                                    </Button>
                                </Grid>
                                <Rectangle DockPanel.Dock="Top" Height="1" Fill="Black" />
                                <AdornerDecorator>
                                    <ContentPresenter />
                                </AdornerDecorator>
                            </DockPanel>
                        </Border>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsActive" Value="False">
                            <Setter TargetName="TitleBar" Property="Background" Value="White" />
                            <Setter TargetName="TitleText" Property="Foreground" Value="Black" />
                        </Trigger>
                        <Trigger Property="WindowState" Value="Maximized">
                            <Setter TargetName="Frame" Property="Margin" Value="7" />
                            <Setter TargetName="MaxButton" Property="Command" Value="{x:Static SystemCommands.RestoreWindowCommand}" />
                            <Setter TargetName="MaxButton" Property="ToolTip" Value="Restaurar" />
                            <Setter TargetName="MaxGlyph" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="RestoreGlyph" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsDialog" Value="True">
                            <Setter TargetName="MinButton" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="MaxButton" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="ResizeMode" Value="NoResize">
                            <Setter TargetName="MaxButton" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Texto de rótulo comum -->
    <Style x:Key="Label" TargetType="TextBlock">
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- Painel afundado da barra de status -->
    <Style x:Key="StatusPanel" TargetType="Border">
        <Setter Property="BorderBrush" Value="{StaticResource Shadow}" />
        <Setter Property="BorderThickness" Value="1,1,0,0" />
        <Setter Property="Margin" Value="0,0,4,0" />
        <Setter Property="Padding" Value="0" />
    </Style>
</ResourceDictionary>
